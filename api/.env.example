# Copie para .env e ajuste os valores.
NODE_ENV=development
PORT=3333

# PostgreSQL do docker compose da raiz (porta 5433 para não conflitar com um Postgres local na 5432)
DATABASE_URL=postgresql://devocional:devocional@localhost:5433/devocional?schema=public

# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-por-um-segredo-com-pelo-menos-32-caracteres
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_DIAS=30

# Origens permitidas separadas por vírgula, ou * em desenvolvimento
CORS_ORIGINS=*
